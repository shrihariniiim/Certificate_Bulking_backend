# Database configuration
# SQLite default (use relative or absolute path)
# For PostgreSQL switch to: postgresql+psycopg://username:password@localhost:5432/certificates_db
DATABASE_URL=sqlite:///./storage/app.db

# Storage directory where generated PDFs are stored
STORAGE_DIR=./storage/certificates

# Maximum number of recipients allowed in a single bulk request (request-level validation)
MAX_RECIPIENTS=1000

# Application Metadata
APP_TITLE=Bulk Certificate Generator API
APP_VERSION=1.0.0
